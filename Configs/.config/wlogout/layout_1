{
    "label": "lock",
    "action": "lockscreen.sh",
    "text": "Lock (l)",
    "keybind": "l"
}

{
    "label": "logout",
    "action": "hyde-shell logout",
    "text": "Logout (e)",
    "keybind": "e"
}

{
    "label": "suspend",
    "action": "lockscreen.sh & disown && systemctl suspend",
    "text": "Suspend (u)",
    "keybind": "u"
}

{
    "label": "shutdown",
    "action": "systemctl poweroff",
    "text": "Shutdown (s)",
    "keybind": "s"
}

{
    "label": "hibernate",
    "action": "lockscreen.sh & disown && sleep 1 && systemctl hibernate",
    "text": "Hibernate (h)",
    "keybind": "h"
}

{
    "label": "reboot",
    "action": "systemctl reboot",
    "text": "Reboot (r)",
    "keybind": "r"
}
